{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E.L.Y.S.I.A",
  "version": "0.1.0",
  "identifier": "com.lorran.jarvis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "E.L.Y.S.I.A",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "E.L.Y.S.I.A local desktop assistant",
    "longDescription": "E.L.Y.S.I.A (Enhanced Logic & Yielding Systems for Intelligent Assistance): assistente desktop com IA local e interação por voz.",
    "copyright": "Lorran1690",
    "category": "Utility"
  }
}
